{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix modyx-ai install --no-audit --no-fund",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index.js" }],
  "crons": [{ "path": "/api/cron", "schedule": "0 * * * *" }]
}
