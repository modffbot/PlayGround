# ===== MODYX AI - Environment =====
PORT=3000

# --- Auth ---
AUTH_SECRET=change-me-to-a-long-random-secret-min-32-chars
ADMIN_EMAIL=admin@modyx.ai
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=MODYX Admin

# --- Admin hardening (production) ---
# Unlock gate prefers the hash; account seeding needs the plain value (set BOTH to the same strong secret).
ADMIN_PASSWORD_HASH=
# Generate: node -e "console.log(require('bcryptjs').hashSync('YOUR_SECRET',10))"
ADMIN_2FA_SECRET=

# --- Database ---
# SQLite file path (built-in node:sqlite, no install needed).
# For Postgres in production, set DATABASE_URL and extend backend/db.js
DATABASE_URL=sqlite:./data/modyx.db

# --- AI Provider (pluggable) ---
# provider: mock | openai | anthropic | gemini | ollama | openai-compatible
AI_PROVIDER=mock
AI_MODEL=modyx-mock-1
AI_API_KEY=
# For OpenAI-compatible / Ollama:
AI_BASE_URL=
# e.g. OpenAI: https://api.openai.com/v1
# e.g. Ollama: http://localhost:11434/v1
# Gemini key uses https://generativelanguage.googleapis.com
# Anthropic uses https://api.anthropic.com

# --- Web Search (optional, honest sources only) ---
# If empty, backend uses DuckDuckGo Instant Answers + Wikipedia (no key, real results).
TAVILY_API_KEY=
SERPER_API_KEY=

# --- GitHub (optional, user PATs are stored per-account, read-only usage) ---
# No server key needed. Users connect their own token from the app.

# --- Push (optional) ---
# Without VAPID keys, push shows "needs provider" and in-app notifications are used.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Images ---
AI_IMAGE_MODEL=dall-e-3

# --- Google OAuth (optional; without keys the Google button stays hidden) ---
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
# Authorized redirect URI: https://YOUR-DOMAIN/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Telegram bot (optional; without token the app shows "needs provider") ---
# Create via @BotFather, then set webhook from Admin → Pro → Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=
TELEGRAM_WEBHOOK_SECRET=change-me-random-string

# --- Limits (overridable from Admin Panel) ---
DAILY_MESSAGES_LIMIT=100
DAILY_FILES_LIMIT=20
DAILY_SEARCH_LIMIT=30
MAX_UPLOAD_MB=15
